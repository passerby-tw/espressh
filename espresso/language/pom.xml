<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.espressh</groupId>
    <artifactId>espressh-parent</artifactId>
    <version>0.29.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>espressh-espresso-language</artifactId>
  <properties><maven.compiler.release>22</maven.compiler.release></properties>
  <dependencies>
    <dependency><groupId>org.graalvm.truffle</groupId><artifactId>truffle-api</artifactId><version>${graalvm.version}</version></dependency>
    <dependency><groupId>org.graalvm.truffle</groupId><artifactId>truffle-nfi</artifactId><version>${graalvm.version}</version></dependency>
    <dependency><groupId>org.graalvm.espresso</groupId><artifactId>espresso-shared</artifactId><version>${graalvm.version}</version></dependency>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm</artifactId><version>9.8</version></dependency>
    <dependency><groupId>org.graalvm.truffle</groupId><artifactId>truffle-dsl-processor</artifactId><version>${graalvm.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.espressh</groupId><artifactId>espressh-espresso-processor</artifactId><version>${project.version}</version><scope>provided</scope></dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.basedir}/../espresso/src</sourceDirectory>
    <resources>
      <resource>
        <directory>${project.basedir}/../espresso/src/com.oracle.truffle.espresso/src</directory>
        <includes><include>META-INF/**</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <proc>full</proc>
          <includes>
            <include>com.oracle.truffle.espresso/src/**/*.java</include>
            <include>com.oracle.truffle.espresso.jdwp/src/**/*.java</include>
            <include>com.oracle.truffle.espresso.memory.panama/src/**/*.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
