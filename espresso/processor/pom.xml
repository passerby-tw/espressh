<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.espressh</groupId>
    <artifactId>espressh-parent</artifactId>
    <version>0.29.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>espressh-espresso-processor</artifactId>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.proc>none</maven.compiler.proc>
  </properties>
  <build>
    <sourceDirectory>${project.basedir}/../espresso/src/com.oracle.truffle.espresso.processor/src</sourceDirectory>
    <resources>
      <resource>
        <directory>${project.basedir}/../espresso/src/com.oracle.truffle.espresso.processor/src</directory>
        <includes><include>META-INF/services/**</include></includes>
      </resource>
    </resources>
  </build>
</project>
